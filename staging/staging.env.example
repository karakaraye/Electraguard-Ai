# Use fresh independent cryptographically random values in staging/.env.
TRACK5_SECRET_KEY=
TRACK5_INTAKE_TOKEN=
POSTGRES_PASSWORD=

TRACK5_ALLOWED_HOSTS=localhost
TRACK5_HTTPS_PORT=8443
# Use an absolute path outside this repository. Use forward slashes on Windows.
TRACK5_TLS_DIR=
# Keep the edge address inside this otherwise unused Docker subnet.
TRACK5_EDGE_SUBNET=172.29.65.0/24
TRACK5_EDGE_IP=172.29.65.2
TRACK5_RECEIPT_LIFETIME_DAYS=30
TRACK5_INTAKE_PAUSED=0
