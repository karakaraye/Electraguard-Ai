resolver 127.0.0.11 valid=10s ipv6=off;

upstream django {
    zone django 64k;
    server backend:8000 resolve;
}

upstream next {
    zone next 64k;
    server frontend:3000 resolve;
}

access_log off;
error_log /dev/null;
server_tokens off;
limit_req_zone $binary_remote_addr zone=sign_in_peer:10m rate=30r/m;

server {
    listen 8443 ssl default_server;
    server_name ${ELECTRAGUARD_HOST};
    ssl_certificate /tls/fullchain.pem;
    ssl_certificate_key /tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 2304k;
    client_body_timeout 45s;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Referrer-Policy "same-origin" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    proxy_hide_header Strict-Transport-Security;
    proxy_hide_header Referrer-Policy;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header X-Powered-By;

    if ($host != ${ELECTRAGUARD_HOST}) { return 421; }

    proxy_http_version 1.1;
    proxy_set_header Host ${ELECTRAGUARD_HOST};
    proxy_set_header X-Forwarded-Host ${ELECTRAGUARD_HOST};
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Port 443;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Forwarded "";

    location = /api/auth/sign-in {
        limit_req zone=sign_in_peer burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://django;
    }

    location /api/ {
        proxy_pass http://django;
    }

    location / {
        proxy_buffering off;
        proxy_pass http://next;
    }
}

server {
    listen 8081;

    # This listener is accessible only to containers attached to the Compose networks.
    location /api/ {
        limit_except GET { deny all; }
        proxy_http_version 1.1;
        proxy_set_header Host ${ELECTRAGUARD_HOST};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header Forwarded "";
        proxy_pass http://django;
    }

    location / { return 404; }
}
