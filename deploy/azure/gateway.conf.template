# Container Apps resolves app names to the environment's internal TCP ingress.
upstream django {
    server backend:8000;
}

upstream next {
    server frontend:3000;
}

# Container Apps' proxy terminates TLS. Take the client address from its
# X-Forwarded-For only when the connection comes from the environment's subnet.
set_real_ip_from ${ELECTRAGUARD_TRUSTED_PROXY_CIDR};
real_ip_header X-Forwarded-For;
real_ip_recursive on;

access_log off;
error_log /dev/null;
server_tokens off;
limit_req_zone $binary_remote_addr zone=sign_in_peer:10m rate=30r/m;

server {
    listen 8080 default_server;
    server_name ${ELECTRAGUARD_HOST};
    client_max_body_size 2304k;
    client_body_timeout 45s;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Referrer-Policy "same-origin" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    proxy_hide_header Strict-Transport-Security;
    proxy_hide_header Referrer-Policy;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header X-Powered-By;

    if ($host != ${ELECTRAGUARD_HOST}) { return 421; }

    proxy_http_version 1.1;
    proxy_set_header Host ${ELECTRAGUARD_HOST};
    proxy_set_header X-Forwarded-Host ${ELECTRAGUARD_HOST};
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Port 443;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Forwarded "";

    location = /api/auth/sign-in {
        limit_req zone=sign_in_peer burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://django;
    }

    location /api/ {
        proxy_pass http://django;
    }

    location / {
        proxy_buffering off;
        proxy_pass http://next;
    }
}

server {
    listen 8081;

    # Reachable only inside the Container Apps environment (an internal port mapping).
    location /api/ {
        limit_except GET { deny all; }
        proxy_http_version 1.1;
        proxy_set_header Host ${ELECTRAGUARD_HOST};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header Forwarded "";
        proxy_pass http://django;
    }

    location / { return 404; }
}
